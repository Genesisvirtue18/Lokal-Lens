# Frontend (Vercel). Only values starting with NEXT_PUBLIC_ are visible in the browser.
# The backend address, ending in /api/v1
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api/v1
# This site's own address, no trailing slash (used for links, sitemap and sharing)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
