NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/business_directory
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CLIENT_URL_2=http://localhost:3000
# Optional trusted proxy hop count or comma-separated trusted proxy IPs/CIDRs; use 1 for Render.
TRUST_PROXY=
EMAIL_FROM=
# SMTP is required in production: login codes and password resets are sent by email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RATE_LIMIT_MAX=
SMS_PROVIDER=development
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_PLACES_API_KEY=
# rating is the low-cost default; reviews can incur the Enterprise + Atmosphere SKU.
GOOGLE_PLACES_REVIEW_MODE=reviews
GOOGLE_PLACES_RATE_LIMIT_MAX=20
# Optional until Google Business Profile API access is approved. Configure all four values to enable owner OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://directory-backend-ai6r.onrender.com/api/v1/google-business-profile/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=76f7488054b30ffa3e4913a7eaaab735ee5139fc8b14c20c23a52266c08a0ec1
